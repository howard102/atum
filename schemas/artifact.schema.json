{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/howard102/atum/schemas/artifact.schema.json",
  "title": "Atum Artifacts",
  "description": "AC、evidence、verdict 三類 artifact 的結構。證據一律可重放——不接受自然語言敘述。",
  "$defs": {

    "acceptanceCriterion": {
      "title": "Acceptance Criterion",
      "description": "二元判斷且附可執行驗證指令。無指令的標準不得寫入。",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification_command", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[0-9]{2,}$" },
        "statement": { "type": "string", "minLength": 1 },
        "verification_command": { "type": "string", "minLength": 1 },
        "expected": {
          "description": "二元期望值。exit_code 或 stdout 比對擇一，不接受「看起來正確」。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exit_code": { "type": "integer" },
            "stdout_matches": { "type": "string" }
          },
          "minProperties": 1
        },
        "traces_to": {
          "description": "回溯到哪一條 requirement；無法回溯者為 scope creep。",
          "type": "string"
        }
      }
    },

    "evidence": {
      "title": "Execution Evidence",
      "description": "可重放的執行證據。console 輸出、人工目視、口頭推論一律不算。",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "stdout_digest", "timestamp", "executor"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "stdout_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "timestamp": { "type": "string", "format": "date-time" },
        "executor": {
          "description": "實際執行者：<model-id> / <role-id>。",
          "type": "string",
          "minLength": 1
        }
      }
    },

    "redGreenPair": {
      "title": "RED/GREEN Evidence Pair",
      "description": "同一組指令的失敗態與通過態。只有 GREEN 不構成證據——無 RED 無法證明測試會偵測到缺陷。",
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_criterion_id", "red", "green"],
      "properties": {
        "acceptance_criterion_id": { "type": "string", "pattern": "^AC-[0-9]{2,}$" },
        "red": {
          "allOf": [
            { "$ref": "#/$defs/evidence" },
            { "properties": { "exit_code": { "not": { "const": 0 } } } }
          ]
        },
        "green": {
          "allOf": [
            { "$ref": "#/$defs/evidence" },
            { "properties": { "exit_code": { "const": 0 } } }
          ]
        }
      }
    },

    "reviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "dimension", "location", "statement"],
      "properties": {
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "dimension": {
          "type": "string",
          "enum": ["security", "correctness", "reliability", "maintainability"]
        },
        "location": {
          "description": "檔案:行號。無法指出出處者須標為推測，不列為 finding。",
          "type": "string",
          "minLength": 1
        },
        "statement": { "type": "string", "minLength": 1 },
        "required_mitigation": { "type": "string" }
      }
    },

    "reviewVerdict": {
      "title": "Read-only Review Verdict",
      "description": "clear = 無 critical/high 且 medium<3；caution = 1-3 high 或 >=3 medium 且皆可處理；blocked = 任一 critical 或 >=4 high。clear/caution 亦須留 sign-off 理由。",
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "sign_off", "findings", "reviewer"],
      "properties": {
        "verdict": { "type": "string", "enum": ["clear", "caution", "blocked"] },
        "sign_off": { "type": "string", "minLength": 1 },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/reviewFinding" } },
        "reviewer": { "type": "string", "minLength": 1 },
        "self_referential": {
          "description": "true 表示受審對象為審查機制自身；此時仲裁方須逐項複驗被宣告為無問題的項目。",
          "type": "boolean",
          "default": false
        }
      }
    },

    "verificationVerdict": {
      "title": "Clean-state Verification Verdict",
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "evidence", "verifier", "clean_state"],
      "properties": {
        "verdict": { "type": "string", "enum": ["verified", "failed"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "minItems": 1 },
        "verifier": { "type": "string", "minLength": 1 },
        "clean_state": {
          "description": "是否自乾淨狀態執行。false 時 verdict 不得為 verified。",
          "type": "boolean"
        },
        "scope_creep": {
          "description": "反向 scope 檢查：無法回溯到任何 AC 的新增程式碼／端點／依賴。",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "gateBypass": {
      "title": "Gate Bypass Record",
      "description": "Gate 不得靜默放行。任何 bypass 必須記錄且不計為通過（Constitution #15）。",
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "reason", "timestamp"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "counts_as_passed": { "const": false }
      }
    }
  }
}
